---
import Button from "./Button.astro";

interface Props {
  brandName?: string;
  brandSuffix?: string;
  stockStatus?: string;
  ctaText?: string;
  ctaTarget?: string;
}

const {
  brandName = "ARTOOLS",
  brandSuffix = ".PRO",
  stockStatus = "Em Estoque",
  ctaText = "Garantir Caneta",
  ctaTarget = "#manifesto-glow-dobra4",
} = Astro.props;
---

<!-- STICKY GLASS NAVIGATION BAR -->
<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 bg-[#F0F0EB]/75 backdrop-blur-xl border-b border-stone-300/80 transition-all duration-300"
>
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-3.5 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div
        class="w-8 h-8 rounded-lg bg-stone-900 flex items-center justify-center text-white transition-transform group-hover:rotate-180 duration-500 shadow-sm"
      >
        <iconify-icon icon="solar:pen-bold" class="text-base"></iconify-icon>
      </div>
      <span class="font-display font-bold tracking-tighter text-lg text-stone-900">
        {brandName}<span class="text-stone-400 font-light">{brandSuffix}</span>
      </span>
    </a>

    <!-- Section Jump Links -->
    <nav class="hidden md:flex items-center gap-7 font-mono text-[11px] uppercase tracking-widest text-stone-600 font-medium">
      <a href="/#hero-title" class="hover:text-stone-950 transition-colors">01 // Visual</a>
      <a href="/#tech-architecture" class="hover:text-stone-950 transition-colors">02 // Arquitetura</a>
      <a href="/#precision-experience" class="hover:text-stone-950 transition-colors">03 // Telemetria</a>
      <a href="/pagina-2" class="hover:text-stone-950 transition-colors flex items-center gap-1 font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        04 // Catálogo
      </a>
      <a href="/pagina-3" class="hover:text-stone-950 transition-colors flex items-center gap-1 font-bold">
        05 // Detalhes
      </a>
    </nav>

    <!-- Stock Status & CTA -->
    <div class="flex items-center gap-4">
      <span class="hidden sm:inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-stone-600 bg-white/70 px-3 py-1.5 rounded-lg border border-stone-300/60 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{stockStatus}</span>
      </span>

      <Button id="nav-cta-btn" variant="beam" size="sm" rounded="rounded-lg" href="/pagina-2">
        {ctaText}
      </Button>
    </div>
  </div>
</header>
