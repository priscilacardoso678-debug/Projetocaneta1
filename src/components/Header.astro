---
import Button from "./Button.astro";

interface Props {
  brandName?: string;
  brandSuffix?: string;
  stockStatus?: string;
  ctaText?: string;
  ctaTarget?: string;
}

const {
  brandName = "ARTOOLS",
  brandSuffix = ".PRO",
  stockStatus = "Em Estoque",
  ctaText = "Garantir Caneta",
  ctaTarget = "#manifesto-glow-dobra4",
} = Astro.props;
---

<!-- STICKY GLASS NAVIGATION BAR -->
<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 bg-[#F0F0EB]/85 backdrop-blur-xl border-b border-stone-300/80 transition-all duration-300 font-sans"
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-12 py-3 md:py-3.5 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div
        class="w-8 h-8 rounded-lg bg-stone-900 flex items-center justify-center text-white transition-transform group-hover:rotate-180 duration-500 shadow-sm"
      >
        <iconify-icon icon="solar:pen-bold" class="text-base"></iconify-icon>
      </div>
      <span class="font-sans font-bold tracking-tight text-lg text-stone-900">
        {brandName}<span class="text-stone-400 font-light">{brandSuffix}</span>
      </span>
    </a>

    <!-- Desktop Section Jump Links -->
    <nav class="hidden md:flex items-center gap-7 font-sans text-xs uppercase tracking-wider text-stone-600 font-semibold">
      <a href="/#hero-title" class="hover:text-stone-950 transition-colors">01 // Visual</a>
      <a href="/#tech-architecture" class="hover:text-stone-950 transition-colors">02 // Arquitetura</a>
      <a href="/#precision-experience" class="hover:text-stone-950 transition-colors">03 // Telemetria</a>
      <a href="/pagina-2" class="hover:text-stone-950 transition-colors flex items-center gap-1.5 font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        04 // Catálogo
      </a>
      <a href="/pagina-3" class="hover:text-stone-950 transition-colors flex items-center gap-1.5 font-bold">
        05 // Detalhes
      </a>
    </nav>

    <!-- Stock Status, Desktop CTA & Mobile Toggle -->
    <div class="flex items-center gap-2 sm:gap-4">
      <span class="hidden lg:inline-flex items-center gap-2 font-sans text-[11px] uppercase tracking-wider text-stone-600 bg-white/70 px-3 py-1.5 rounded-lg border border-stone-300/60 shadow-sm font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{stockStatus}</span>
      </span>

      <!-- CTA Button (Visible on desktop & larger mobile) -->
      <div class="hidden sm:block">
        <Button id="nav-cta-btn" variant="beam" size="sm" rounded="rounded-lg" href="/pagina-2" class="[&_.btn-beam-content]:!font-sans [&_.btn-beam-content]:font-bold">
          {ctaText}
        </Button>
      </div>

      <!-- Mobile Menu Hamburger Toggle Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        class="md:hidden relative w-10 h-10 rounded-xl bg-white/80 border border-stone-300/80 hover:border-stone-400 text-stone-900 flex flex-col items-center justify-center gap-1.5 transition-all duration-300 shadow-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-stone-900/20"
      >
        <span class="hamburger-line line-1 w-5 h-[2px] bg-stone-900 rounded-full transition-all duration-300 origin-center"></span>
        <span class="hamburger-line line-2 w-5 h-[2px] bg-stone-900 rounded-full transition-all duration-300 origin-center"></span>
        <span class="hamburger-line line-3 w-3.5 h-[2px] bg-stone-900 rounded-full transition-all duration-300 origin-center self-end mr-2.5"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Backdrop Blur Overlay -->
  <div
    id="mobile-menu-backdrop"
    class="fixed inset-0 top-[57px] bg-stone-950/40 backdrop-blur-sm z-30 transition-opacity duration-300 opacity-0 pointer-events-none md:hidden"
  ></div>

  <!-- Mobile Menu Drawer Dropdown -->
  <div
    id="mobile-menu-drawer"
    class="fixed top-[57px] left-0 right-0 z-40 md:hidden bg-[#F0F0EB]/95 backdrop-blur-2xl border-b border-stone-300/90 shadow-2xl transition-all duration-300 ease-in-out -translate-y-[120%] opacity-0 pointer-events-none max-h-[calc(100dvh-57px)] overflow-y-auto font-sans"
  >
    <div class="px-5 py-4 flex items-center justify-between border-b border-stone-300/60 bg-white/40">
      <div class="inline-flex items-center gap-2 font-sans text-[11px] uppercase tracking-wider text-stone-700 bg-white/90 px-3 py-1.5 rounded-lg border border-stone-300/70 shadow-sm font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{stockStatus} // Lote VIP Ativo</span>
      </div>
      <span class="font-sans text-[11px] text-stone-400 uppercase tracking-wider font-semibold">LINHA 2026</span>
    </div>

    <!-- Mobile Navigation Links -->
    <nav class="p-4 space-y-1.5 font-sans">
      <a
        href="/#hero-title"
        class="mobile-nav-link flex items-center justify-between p-3.5 rounded-xl hover:bg-white/80 active:bg-white transition-all text-stone-800 hover:text-stone-950 group"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-stone-200/80 text-stone-700 group-hover:bg-stone-900 group-hover:text-white transition-colors flex items-center justify-center text-xs font-bold font-sans">01</span>
          <span class="font-sans font-semibold text-base text-stone-900 tracking-tight">Visual & Design</span>
        </div>
        <iconify-icon icon="solar:arrow-right-linear" class="text-stone-400 group-hover:text-stone-900 group-hover:translate-x-1 transition-all text-lg"></iconify-icon>
      </a>

      <a
        href="/#tech-architecture"
        class="mobile-nav-link flex items-center justify-between p-3.5 rounded-xl hover:bg-white/80 active:bg-white transition-all text-stone-800 hover:text-stone-950 group"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-stone-200/80 text-stone-700 group-hover:bg-stone-900 group-hover:text-white transition-colors flex items-center justify-center text-xs font-bold font-sans">02</span>
          <span class="font-sans font-semibold text-base text-stone-900 tracking-tight">Arquitetura Tecnológica</span>
        </div>
        <iconify-icon icon="solar:arrow-right-linear" class="text-stone-400 group-hover:text-stone-900 group-hover:translate-x-1 transition-all text-lg"></iconify-icon>
      </a>

      <a
        href="/#precision-experience"
        class="mobile-nav-link flex items-center justify-between p-3.5 rounded-xl hover:bg-white/80 active:bg-white transition-all text-stone-800 hover:text-stone-950 group"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-stone-200/80 text-stone-700 group-hover:bg-stone-900 group-hover:text-white transition-colors flex items-center justify-center text-xs font-bold font-sans">03</span>
          <span class="font-sans font-semibold text-base text-stone-900 tracking-tight">Telemetria & Simulador</span>
        </div>
        <iconify-icon icon="solar:arrow-right-linear" class="text-stone-400 group-hover:text-stone-900 group-hover:translate-x-1 transition-all text-lg"></iconify-icon>
      </a>

      <a
        href="/pagina-2"
        class="mobile-nav-link flex items-center justify-between p-3.5 rounded-xl bg-white/50 border border-stone-300/60 hover:bg-white transition-all text-stone-900 group shadow-sm"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-stone-900 text-white flex items-center justify-center text-xs font-bold shadow-sm font-sans">04</span>
          <div class="flex flex-col">
            <span class="font-sans font-bold text-base text-stone-900 tracking-tight flex items-center gap-1.5">
              Catálogo Completo
              <span class="px-1.5 py-0.5 text-[9px] bg-emerald-100 text-emerald-800 border border-emerald-300/60 rounded font-sans font-bold">9 Modelos</span>
            </span>
            <span class="font-sans text-xs text-stone-500 font-medium">Linha Pigmentum 2026</span>
          </div>
        </div>
        <iconify-icon icon="solar:arrow-right-bold" class="text-stone-900 group-hover:translate-x-1.5 transition-transform text-xl"></iconify-icon>
      </a>

      <a
        href="/pagina-3"
        class="mobile-nav-link flex items-center justify-between p-3.5 rounded-xl hover:bg-white/80 active:bg-white transition-all text-stone-800 hover:text-stone-950 group"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-stone-200/80 text-stone-700 group-hover:bg-stone-900 group-hover:text-white transition-colors flex items-center justify-center text-xs font-bold font-sans">05</span>
          <span class="font-sans font-semibold text-base text-stone-900 tracking-tight">Especificações & Preços</span>
        </div>
        <iconify-icon icon="solar:arrow-right-linear" class="text-stone-400 group-hover:text-stone-900 group-hover:translate-x-1 transition-all text-lg"></iconify-icon>
      </a>
    </nav>

    <!-- Mobile Drawer Footer CTA -->
    <div class="p-5 pt-3 space-y-3 bg-stone-200/50 border-t border-stone-300/70 font-sans">
      <a
        href="/pagina-2"
        class="mobile-nav-link btn-beam w-full px-[1px] py-[1px] group cursor-pointer shadow-md shadow-stone-950/10 rounded-xl block text-center"
      >
        <div class="btn-beam-content !font-sans uppercase font-bold flex items-center justify-center gap-2 rounded-xl py-3.5 text-xs tracking-wider">
          <span>{ctaText}</span>
          <iconify-icon icon="solar:arrow-right-linear" class="text-base group-hover:translate-x-1 transition-transform"></iconify-icon>
        </div>
      </a>
      <div class="flex items-center justify-between font-sans text-[10px] uppercase tracking-wider text-stone-500 font-medium pt-1">
        <span>ARTOOLS PRECISION</span>
        <span>SWISS TECH 0.01MM</span>
      </div>
    </div>
  </div>
</header>

<style>
  /* Hamburger morph to X state */
  #mobile-menu-toggle[aria-expanded="true"] .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #mobile-menu-toggle[aria-expanded="true"] .line-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-toggle[aria-expanded="true"] .line-3 {
    transform: translateY(-7px) rotate(-45deg);
    width: 20px;
    margin-right: 0;
    align-self: center;
  }
</style>

<script is:inline>
  (function initMobileMenu() {
    function setup() {
      const toggleBtn = document.getElementById("mobile-menu-toggle");
      const drawer = document.getElementById("mobile-menu-drawer");
      const backdrop = document.getElementById("mobile-menu-backdrop");
      const navLinks = document.querySelectorAll(".mobile-nav-link");

      if (!toggleBtn || !drawer || !backdrop) return;

      let isOpen = false;

      function openMenu() {
        isOpen = true;
        toggleBtn.setAttribute("aria-expanded", "true");
        toggleBtn.setAttribute("aria-label", "Fechar menu de navegação");

        drawer.classList.remove("-translate-y-[120%]", "opacity-0", "pointer-events-none");
        drawer.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");

        backdrop.classList.remove("opacity-0", "pointer-events-none");
        backdrop.classList.add("opacity-100", "pointer-events-auto");

        document.body.style.overflow = "hidden";
      }

      function closeMenu() {
        isOpen = false;
        toggleBtn.setAttribute("aria-expanded", "false");
        toggleBtn.setAttribute("aria-label", "Abrir menu de navegação");

        drawer.classList.add("-translate-y-[120%]", "opacity-0", "pointer-events-none");
        drawer.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");

        backdrop.classList.add("opacity-0", "pointer-events-none");
        backdrop.classList.remove("opacity-100", "pointer-events-auto");

        document.body.style.overflow = "";
      }

      toggleBtn.addEventListener("click", () => {
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      backdrop.addEventListener("click", closeMenu);

      // Close on escape key
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen) {
          closeMenu();
        }
      });

      // Close on viewport resize to desktop
      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768 && isOpen) {
          closeMenu();
        }
      });

      // Handle navigation links click
      navLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          const href = link.getAttribute("href") || "";
          closeMenu();

          // If it's a hash link on the current page, smooth scroll with lenis if available
          if (href.startsWith("/#") && window.location.pathname === "/") {
            e.preventDefault();
            const targetId = href.replace("/", "");
            const targetEl = document.querySelector(targetId);
            if (targetEl) {
              if (window.lenis) {
                window.lenis.scrollTo(targetEl, { offset: -60 });
              } else {
                targetEl.scrollIntoView({ behavior: "smooth" });
              }
            }
          }
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setup);
    } else {
      setup();
    }
  })();
</script>
