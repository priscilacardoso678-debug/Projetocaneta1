---
interface Props {
  title?: string;
  spec?: string;
  tags?: string[];
  backToTopText?: string;
}

const {
  title = "ARTOOLS PIGMENTUM SERIES",
  spec = "SPECIFICATION v2.0",
  tags = ["Precision Engineering", "Swiss Specification", "Aerospace Grade"],
  backToTopText = "Voltar ao Topo",
} = Astro.props;
---

<!-- FOOTER SECTION -->
<footer class="relative z-30 bg-[#050505] text-stone-400 border-t border-stone-800/80 py-12 px-6 md:px-12 lg:px-20 font-mono text-xs">
  <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Brand Info -->
    <div class="flex items-center gap-3">
      <div class="w-7 h-7 rounded-lg bg-white text-stone-950 flex items-center justify-center font-bold shadow-md">
        <iconify-icon icon="solar:pen-bold" class="text-xs"></iconify-icon>
      </div>
      <span class="font-display font-bold text-white text-sm tracking-tight">{title}</span>
      <span class="text-stone-700 font-light">|</span>
      <span class="text-stone-500">{spec}</span>
    </div>

    <!-- Feature Tags -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-[11px] uppercase tracking-widest text-stone-500 font-medium">
      {tags.map((tag, index) => (
        <>
          <span>{tag}</span>
          {index < tags.length - 1 && <span>•</span>}
        </>
      ))}
    </div>

    <!-- Back To Top Button -->
    <button
      id="back-to-top-btn"
      class="px-4 py-2 border border-stone-800 rounded-xl hover:bg-white hover:text-stone-950 transition-all uppercase tracking-widest text-[10px] font-bold flex items-center gap-2 shadow-sm cursor-pointer hover:-translate-y-[1px]"
    >
      <span>{backToTopText}</span>
      <iconify-icon icon="solar:arrow-up-linear" class="text-xs"></iconify-icon>
    </button>
  </div>
</footer>
