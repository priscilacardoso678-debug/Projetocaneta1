---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import StrokeButton from "../components/StrokeButton.astro";
import StressButton from "../components/StressButton.astro";
import StatCard from "../components/StatCard.astro";
---

<Layout title="Precision Series - A caneta mais tecnológica do mundo">
  <!-- Smooth Scroll Wrapper -->
  <main id="smooth-wrapper" class="relative w-full">
    <div id="smooth-content">

      <!-- Hero Section (Pinned by GSAP) -->
      <section class="hero-section relative h-[100dvh] w-full flex items-center overflow-hidden bg-[#F0F0EB] z-10">
        <!-- Fullscreen Video Container / Canvas Image Sequence -->
        <div class="video-container absolute inset-0 w-full h-full z-0 origin-center overflow-hidden bg-stone-900">
          <canvas
            id="hero-canvas"
            class="absolute inset-0 w-full h-full z-0 block"
          ></canvas>
          <!-- Gradient overlays for text legibility -->
          <div class="absolute inset-0 bg-gradient-to-r from-[#F0F0EB] via-[#F0F0EB]/80 to-transparent w-[90%] md:w-[70%] pointer-events-none"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#F0F0EB] via-transparent to-transparent h-[40%] bottom-0 top-auto pointer-events-none"></div>
        </div>

        <!-- Main Content (Floating over video) -->
        <div class="max-w-[1440px] w-full mx-auto px-6 md:px-12 lg:px-20 flex items-center relative z-10 h-full pointer-events-none">
          <!-- Left Column: Typography & Actions -->
          <div class="hero-left-content w-full max-w-2xl flex flex-col justify-center h-full pt-20 lg:pt-0 pointer-events-auto">
            <div class="space-y-3.5 md:space-y-4">
              <!-- Eyebrow Badge -->
              <div class="hero-element inline-flex items-center gap-2 px-3 py-1.5 bg-white/70 border border-stone-300/50 backdrop-blur-sm rounded-lg font-mono text-[10px] md:text-xs uppercase tracking-widest text-stone-600 shadow-sm shimmer-slide">
                <span class="w-1.5 h-1.5 bg-stone-900 rounded-full animate-pulse"></span>
                PRECISION SERIES
              </div>

              <!-- Main Title -->
              <h1 id="hero-title" class="font-display font-bold leading-[0.88] tracking-tighter text-[3.2rem] md:text-[5rem] lg:text-[6rem] xl:text-[7rem] flex flex-col items-start select-none">
                <span class="text-reveal-wrapper"><span class="text-reveal-content text-stone-900">A caneta</span></span>
                <span class="text-reveal-wrapper text-stroke"><span class="text-reveal-content">mais tecnológica</span></span>
                <span class="text-reveal-wrapper"><span class="text-reveal-content text-stone-400">do mundo.</span></span>
              </h1>

              <!-- Description -->
              <p class="hero-element text-sm md:text-base text-stone-800 max-w-md font-medium leading-snug drop-shadow-sm">
                Engenharia de precisão fundida com materiais aeroespaciais. Redefinindo o ato de
                escrever através do silêncio visual e de um luxo genuinamente minimalista.
              </p>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 items-center pt-2 md:pt-3">
                <!-- Primary Button -->
                <Button id="hero-buy-btn" variant="beam" class="hero-element" icon="solar:arrow-right-linear">
                  Comprar Agora
                </Button>

                <!-- Secondary Button -->
                <Button id="hero-explore-btn" variant="outline" class="hero-element">
                  Explorar
                </Button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- MARQUEE DIVIDER STRIP -->
      <div class="relative z-30 border-y border-stone-300/80 bg-white overflow-hidden py-3 text-stone-900 select-none shadow-sm">
        <div class="animate-marquee whitespace-nowrap flex items-center">
          <div class="flex gap-12 items-center font-mono text-xs uppercase tracking-widest text-stone-500 font-medium">
            <span class="text-stone-900 font-bold">ARTOOLS PIGMENTUM 0.1</span> <span class="text-stone-300">•</span>
            <span>ENGENHARIA SUÍÇA 0.01MM</span> <span class="text-stone-300">•</span>
            <span>ALUMÍNIO AEROESPACIAL 6061-T6</span> <span class="text-stone-300">•</span>
            <span>TINTA NANOMAGNÉTICA HD</span> <span class="text-stone-300">•</span>
            <span>EQUALIZAÇÃO BAROMÉTRICA</span> <span class="text-stone-300">•</span>
            <span>GARANTIA VITALÍCIA TOTAL</span> <span class="text-stone-300">•</span>
          </div>
          <div class="flex gap-12 items-center font-mono text-xs uppercase tracking-widest text-stone-500 font-medium pl-12">
            <span class="text-stone-900 font-bold">ARTOOLS PIGMENTUM 0.1</span> <span class="text-stone-300">•</span>
            <span>ENGENHARIA SUÍÇA 0.01MM</span> <span class="text-stone-300">•</span>
            <span>ALUMÍNIO AEROESPACIAL 6061-T6</span> <span class="text-stone-300">•</span>
            <span>TINTA NANOMAGNÉTICA HD</span> <span class="text-stone-300">•</span>
            <span>EQUALIZAÇÃO BAROMÉTRICA</span> <span class="text-stone-300">•</span>
            <span>GARANTIA VITALÍCIA TOTAL</span> <span class="text-stone-300">•</span>
          </div>
        </div>
      </div>

      <!-- Section 2: Arquitetura Tecnológica (Dobra 2) -->
      <section id="tech-architecture" class="relative w-full min-h-screen py-24 md:py-32 px-6 md:px-12 lg:px-20 bg-[#F0F0EB] text-stone-900 border-t border-stone-300/80 z-20 overflow-hidden">
        <!-- Ambient Glow Mesh Backgrounds -->
        <div class="glow-mesh w-[500px] h-[500px] bg-white top-1/4 -left-32"></div>
        <div class="glow-mesh w-[600px] h-[600px] bg-stone-300/50 bottom-10 -right-32"></div>

        <!-- Grid Guide Lines overlay for section -->
        <div class="absolute inset-0 pointer-events-none grid grid-cols-12 z-0 h-full w-full opacity-40">
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="grid-guide-line col-span-1"></div>
          <div class="col-span-1"></div>
        </div>

        <div class="max-w-[1440px] mx-auto relative z-10">
          <!-- Section Header -->
          <div class="max-w-3xl space-y-4 mb-16 md:mb-20">
            <div class="tech-header-element inline-flex items-center gap-2 px-3.5 py-1.5 bg-white/80 border border-stone-300/70 backdrop-blur-md rounded-lg font-mono text-[10px] md:text-xs uppercase tracking-widest text-stone-700 shadow-sm shimmer-slide">
              <span class="w-2 h-2 bg-stone-900 rounded-full animate-ping"></span>
              <span>02 // ARQUITETURA DE PRECISÃO</span>
            </div>

            <h2 class="tech-header-element font-display font-bold text-4xl md:text-6xl lg:text-7xl tracking-tighter text-stone-950 leading-[0.95]">
              Arquitetura <span class="px-3.5 py-1 bg-stone-900 text-[#F0F0EB] rounded-2xl shadow-xl inline-block">Tecnológica</span>
            </h2>

            <p class="tech-header-element text-base md:text-xl text-stone-700 font-medium leading-relaxed max-w-2xl pt-2">
              Desenvolvida sob os padrões mais rigorosos da alta engenharia suíça. Cada micro-componente da ARTOOLS Pigmentum é usinado para redefinir o equilíbrio perfeito entre resistência aeroespacial e escrita indelével.
            </p>
          </div>

          <!-- 2-Column Main Content Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
            <!-- Left Column: Interactive Product Card with Hotspots & Flashlight Effect -->
            <div class="lg:col-span-6 tech-card-visual">
              <div class="flashlight-card relative rounded-3xl p-4 md:p-6 border border-white/80 shadow-2xl shadow-stone-950/10 group overflow-hidden bg-white/50 backdrop-blur-xl">
                <!-- Floating Technical Badges / Hotspots over Pen -->
                <div class="relative w-full aspect-[4/3] md:aspect-[16/11] rounded-2xl overflow-hidden bg-stone-100 flex items-center justify-center">
                  <img
                    src="/assets/artools_pen_tech_macro.png"
                    alt="ARTOOLS Pigmentum Precision Pen"
                    class="w-full h-full object-cover rounded-2xl transform group-hover:scale-105 transition-transform duration-700 ease-out"
                    loading="eager"
                  />
                  
                  <!-- Hotspot 1: Swiss Nib -->
                  <div class="absolute top-[28%] left-[22%] group/hotspot cursor-pointer">
                    <div class="relative flex items-center justify-center">
                      <span class="animate-ping absolute inline-flex h-6 w-6 rounded-full bg-stone-900/30"></span>
                      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-stone-900 border-2 border-white shadow-md"></span>
                      <div class="absolute left-6 top-1/2 -translate-y-1/2 whitespace-nowrap px-3 py-1.5 bg-stone-900/90 text-white backdrop-blur-md rounded-lg font-mono text-[10px] uppercase tracking-wider opacity-0 group-hover/hotspot:opacity-100 transition-all duration-300 pointer-events-none shadow-lg">
                        0.01mm Precision Nib
                      </div>
                    </div>
                  </div>

                  <!-- Hotspot 2: Aerospace Aluminum Body -->
                  <div class="absolute top-[52%] left-[48%] group/hotspot cursor-pointer">
                    <div class="relative flex items-center justify-center">
                      <span class="animate-ping absolute inline-flex h-6 w-6 rounded-full bg-stone-900/30"></span>
                      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-stone-900 border-2 border-white shadow-md"></span>
                      <div class="absolute left-6 top-1/2 -translate-y-1/2 whitespace-nowrap px-3 py-1.5 bg-stone-900/90 text-white backdrop-blur-md rounded-lg font-mono text-[10px] uppercase tracking-wider opacity-0 group-hover/hotspot:opacity-100 transition-all duration-300 pointer-events-none shadow-lg">
                        6061-T6 Aerospace Monoblock
                      </div>
                    </div>
                  </div>

                  <!-- Hotspot 3: Archival Ink Flow -->
                  <div class="absolute bottom-[25%] right-[25%] group/hotspot cursor-pointer">
                    <div class="relative flex items-center justify-center">
                      <span class="animate-ping absolute inline-flex h-6 w-6 rounded-full bg-stone-900/30"></span>
                      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-stone-900 border-2 border-white shadow-md"></span>
                      <div class="absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap px-3 py-1.5 bg-stone-900/90 text-white backdrop-blur-md rounded-lg font-mono text-[10px] uppercase tracking-wider opacity-0 group-hover/hotspot:opacity-100 transition-all duration-300 pointer-events-none shadow-lg">
                        Nanotech Pigment Matrix
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Card Specs Bar at Bottom -->
                <div class="mt-4 pt-4 border-t border-stone-200/80 flex flex-wrap items-center justify-between gap-3 text-stone-600 font-mono text-[11px] uppercase tracking-wider">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:ruler-linear" class="text-sm text-stone-900"></iconify-icon>
                    <span>Diâmetro: 8.5mm</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:scale-linear" class="text-sm text-stone-900"></iconify-icon>
                    <span>Massa: 14.8g</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:shield-check-linear" class="text-sm text-stone-900"></iconify-icon>
                    <span>Garantia: Vitalícia</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Column: Numbered Feature Benefits List -->
            <div class="lg:col-span-6 space-y-4">
              <!-- Benefit 01 -->
              <div class="tech-benefit-item bg-white/70 hover:bg-white border border-stone-300/80 rounded-2xl p-6 md:p-7 backdrop-blur-md shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 group">
                <div class="flex items-start gap-4 md:gap-6">
                  <div class="w-10 h-10 md:w-11 md:h-11 rounded-lg bg-stone-900 text-white font-mono font-bold text-xs md:text-sm flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-md">
                    01
                  </div>
                  <div class="space-y-1.5 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-display font-bold text-lg md:text-xl text-stone-900 group-hover:text-black transition-colors">
                        Engenharia Suíça de Precisão
                      </h3>
                      <span class="px-2.5 py-0.5 bg-stone-200/80 border border-stone-300/70 font-mono text-[10px] uppercase font-semibold text-stone-800 rounded-md">0.01mm Spec</span>
                    </div>
                    <p class="text-xs md:text-sm text-stone-600 font-medium leading-relaxed">
                      Mecanismo de ponta usinado com tolerância micrométrica de 0.01mm sob padrões de relojoaria suíça. Elimina qualquer folga ou micro-vibração ao tocar o papel.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Benefit 02 -->
              <div class="tech-benefit-item bg-white/70 hover:bg-white border border-stone-300/80 rounded-2xl p-6 md:p-7 backdrop-blur-md shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 group">
                <div class="flex items-start gap-4 md:gap-6">
                  <div class="w-10 h-10 md:w-11 md:h-11 rounded-lg bg-stone-900 text-white font-mono font-bold text-xs md:text-sm flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-md">
                    02
                  </div>
                  <div class="space-y-1.5 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-display font-bold text-lg md:text-xl text-stone-900 group-hover:text-black transition-colors">
                        Alumínio Aeroespacial 6061-T6
                      </h3>
                      <span class="px-2.5 py-0.5 bg-stone-200/80 border border-stone-300/70 font-mono text-[10px] uppercase font-semibold text-stone-800 rounded-md">6061-T6 Alloy</span>
                    </div>
                    <p class="text-xs md:text-sm text-stone-600 font-medium leading-relaxed">
                      Corpo monobloco usinado em CNC a partir de um lingote maciço de liga 6061-T6 utilizada em aeronaves. Proporciona leveza biomecânica impecável e dureza extrema.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Benefit 03 -->
              <div class="tech-benefit-item bg-white/70 hover:bg-white border border-stone-300/80 rounded-2xl p-6 md:p-7 backdrop-blur-md shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 group">
                <div class="flex items-start gap-4 md:gap-6">
                  <div class="w-10 h-10 md:w-11 md:h-11 rounded-lg bg-stone-900 text-white font-mono font-bold text-xs md:text-sm flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-md">
                    03
                  </div>
                  <div class="space-y-1.5 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-display font-bold text-lg md:text-xl text-stone-900 group-hover:text-black transition-colors">
                        Tinta Nanotecnológica Arquivística
                      </h3>
                      <span class="px-2.5 py-0.5 bg-stone-200/80 border border-stone-300/70 font-mono text-[10px] uppercase font-semibold text-stone-800 rounded-md">+100 Anos</span>
                    </div>
                    <p class="text-xs md:text-sm text-stone-600 font-medium leading-relaxed">
                      Formulação exclusiva com partículas nanométricas de carbono puro. Secagem ultra-rápida, totalmente impermeável, resistente à luz solar UV e solventes químicos.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Benefit 04 -->
              <div class="tech-benefit-item bg-white/70 hover:bg-white border border-stone-300/80 rounded-2xl p-6 md:p-7 backdrop-blur-md shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 group">
                <div class="flex items-start gap-4 md:gap-6">
                  <div class="w-10 h-10 md:w-11 md:h-11 rounded-lg bg-stone-900 text-white font-mono font-bold text-xs md:text-sm flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-md">
                    04
                  </div>
                  <div class="space-y-1.5 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-display font-bold text-lg md:text-xl text-stone-900 group-hover:text-black transition-colors">
                        Fluxo Micro-Capilar Ativo
                      </h3>
                      <span class="px-2.5 py-0.5 bg-stone-200/80 border border-stone-300/70 font-mono text-[10px] uppercase font-semibold text-stone-800 rounded-md">Zero Leak</span>
                    </div>
                    <p class="text-xs md:text-sm text-stone-600 font-medium leading-relaxed">
                      Sistema interno de equalização de pressão atmosférica que assegura saída de tinta contínua, homogênea e sem borrões, independentemente da altitude ou velocidade de escrita.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Accent Bar & Progress Line -->
          <div class="mt-16 md:mt-20 pt-8 border-t border-stone-300/80 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-4 w-full md:w-auto">
              <span class="font-mono text-xs text-stone-500 uppercase tracking-widest">Progressão de Engenharia</span>
              <div class="h-1 bg-stone-300 rounded-full flex-1 md:w-64 overflow-hidden relative">
                <div id="tech-progress-bar" class="h-full bg-stone-900 rounded-full w-0 transition-all duration-300"></div>
              </div>
            </div>

            <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-stone-600">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>ARTOOLS PIGMENTUM 0.1 ARCHITECTURE</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Telemetria & Experiência de Traço (Dobra 3) -->
      <section id="precision-experience" class="relative w-full min-h-screen py-24 md:py-32 px-6 md:px-12 lg:px-20 bg-[#0c0a09] text-stone-100 border-t border-stone-800/80 z-20 overflow-hidden">
        <!-- Ambient Glow Mesh Backgrounds -->
        <div class="glow-mesh w-[600px] h-[600px] bg-stone-700/30 top-10 right-10"></div>
        <div class="glow-mesh w-[500px] h-[500px] bg-white/10 bottom-10 left-10"></div>

        <!-- Grid Guide Lines overlay for dark section -->
        <div class="absolute inset-0 pointer-events-none grid grid-cols-12 z-0 h-full w-full opacity-20">
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="border-r border-stone-700 col-span-1"></div>
          <div class="col-span-1"></div>
        </div>

        <div class="max-w-[1440px] mx-auto relative z-10 space-y-16 md:space-y-24">
          <!-- Section Header -->
          <div class="max-w-3xl space-y-4">
            <div class="exp-header-element inline-flex items-center gap-2 px-3.5 py-1.5 bg-stone-900/90 border border-stone-700/80 backdrop-blur-md rounded-lg font-mono text-[10px] md:text-xs uppercase tracking-widest text-stone-300 shadow-sm shimmer-slide">
              <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
              <span>03 // TELEMETRIA & SIMULADOR DE TRAÇO</span>
            </div>

            <h2 class="exp-header-element font-display font-bold text-4xl md:text-6xl lg:text-7xl tracking-tighter text-white leading-[0.95]">
              Precisão <span class="px-3.5 py-1 bg-white text-stone-950 rounded-2xl shadow-2xl inline-block">Micrométrica</span>
            </h2>

            <p class="exp-header-element text-base md:text-xl text-stone-400 font-medium leading-relaxed max-w-2xl pt-2">
              Do rascunho técnico de engenharia à assinatura de contratos de alto valor. Selecione a espessura de ponta ideal e teste visualmente a densidade do traço nanotecnológico.
            </p>
          </div>

          <!-- 4 Metric Impact Counter Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <StatCard
              label="Rendimento"
              icon="solar:chart-2-linear"
              value="1.200m"
              description="Autonomia ininterrupta de escrita por cartucho de pigmento concentrado."
            />
            <StatCard
              label="Secagem"
              icon="solar:stopwatch-linear"
              value="0.2s"
              description="Absorção ultra-rápida. Zero borrões em papeis lisos ou para pessoas canhotas."
            />
            <StatCard
              label="Durabilidade"
              icon="solar:shield-star-linear"
              value="+100 Anos"
              description="Pigmento arquivístico à prova de água, radiação UV e solventes químicos."
            />
            <StatCard
              label="Sensor Háptico"
              icon="solar:tuning-square-2-linear"
              value="8.192"
              description="Níveis de resposta de contato para um fluxo constante em qualquer ângulo."
            />
          </div>

          <!-- Interactive Stroke Simulator & Macro Ink Showcase -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
            <!-- Left: Interactive Stroke Tester Canvas Card -->
            <div class="lg:col-span-7 bg-stone-900/80 border border-stone-800 rounded-3xl p-6 md:p-8 flex flex-col justify-between backdrop-blur-xl shadow-2xl space-y-6">
              <div>
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-800 pb-4">
                  <div>
                    <span class="font-mono text-[10px] text-stone-400 uppercase tracking-widest block mb-1">SIMULADOR DE TRAÇO EM TEMPO REAL</span>
                    <h3 class="font-display font-bold text-2xl text-white">Calibração de Ponta</h3>
                  </div>
                  
                  <!-- Tip Size Selector Buttons -->
                  <div class="flex items-center gap-1.5 bg-stone-950 p-1 rounded-xl border border-stone-800">
                    <StrokeButton size="0.05" />
                    <StrokeButton size="0.1" active />
                    <StrokeButton size="0.3" />
                    <StrokeButton size="0.5" />
                    <StrokeButton size="0.8" />
                  </div>
                </div>

                <!-- Dynamic Preview Canvas Container -->
                <div class="relative mt-6 rounded-2xl bg-[#f5f4ef] border border-stone-300/40 p-6 md:p-8 min-h-[220px] flex flex-col justify-between overflow-hidden shadow-inner text-stone-900">
                  <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(#1c1917 0.75px, transparent 0.75px); background-size: 16px 16px;"></div>

                  <div class="relative z-10 flex justify-between items-start">
                    <span id="stroke-spec-badge" class="px-2.5 py-1 bg-stone-900 text-white font-mono text-[10px] uppercase rounded-md shadow">
                      ARTOOLS PIGMENTUM 0.1mm - TRAÇO DE PRECISÃO
                    </span>
