  <!-- Section-specific Animations & Interactions -->
  <script is:inline>
    function setupAnimations() {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
        setTimeout(setupAnimations, 50);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      // 1. Hero Canvas WebP Image Sequence & Scroll Animation
      const canvas = document.getElementById("hero-canvas");
      const manifestoVideo = document.getElementById("manifesto-video");

      if (manifestoVideo) {
        manifestoVideo.muted = true;
        manifestoVideo.defaultMuted = true;
        manifestoVideo.playsInline = true;

        const startVideoPlay = () => {
          if (manifestoVideo.paused) {
            manifestoVideo.muted = true;
            manifestoVideo.play().catch(() => {});
          }
        };

        startVideoPlay();

        // Ensure playback when section enters view
        if ("IntersectionObserver" in window) {
          const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                startVideoPlay();
              }
            });
          }, { threshold: 0.1 });

          const dobra4Section = document.getElementById("manifesto-glow-dobra4");
          if (dobra4Section) videoObserver.observe(dobra4Section);
        }

        // Retry play on any user interaction in case autoplay policy blocked initial attempt
        const triggerPlayOnInteraction = () => {
          startVideoPlay();
          window.removeEventListener("click", triggerPlayOnInteraction);
          window.removeEventListener("scroll", triggerPlayOnInteraction);
          window.removeEventListener("touchstart", triggerPlayOnInteraction);
        };
        window.addEventListener("click", triggerPlayOnInteraction, { once: true });
        window.addEventListener("scroll", triggerPlayOnInteraction, { once: true });
        window.addEventListener("touchstart", triggerPlayOnInteraction, { once: true });
      }

      // Entrance animation for text
      const entranceTl = gsap.timeline({
        onComplete: () => {
          ScrollTrigger.refresh();
        },
      });

      entranceTl.fromTo(
        ".text-reveal-content",
        { y: "110%", opacity: 0, filter: "blur(14px)" },
        { y: "0%", opacity: 1, filter: "blur(0px)", duration: 1.2, stagger: 0.14, ease: "cubic-bezier(0.16, 1, 0.3, 1)" }
      );

      entranceTl.fromTo(
        ".hero-element",
        { y: "2.5rem", opacity: 0, filter: "blur(10px)" },
        { y: "0rem", opacity: 1, filter: "blur(0px)", duration: 1.0, stagger: 0.09, ease: "cubic-bezier(0.16, 1, 0.3, 1)" },
        "-=0.9"
      );

      // Hero Canvas Frame Controller
      if (canvas) {
        const ctx = canvas.getContext("2d");
        const frameCount = 192;
        const images = new Array(frameCount);
        const frameSeq = { frame: 0 };

        const getFrameUrl = (index) =>
          `/assets/video_frames/frame_${String(index + 1).padStart(4, "0")}.webp`;

        function renderFrame(index) {
          if (!ctx || !canvas) return;
          const img = images[index];
          if (!img || !img.complete || !img.naturalWidth) return;

          const cw = canvas.width;
          const ch = canvas.height;
          const iw = img.naturalWidth;
          const ih = img.naturalHeight;

          const canvasRatio = cw / ch;
          const imgRatio = iw / ih;

          let drawW, drawH, drawX, drawY;

          if (canvasRatio > imgRatio) {
            drawW = cw;
            drawH = cw / imgRatio;
            drawX = 0;
            drawY = (ch - drawH) / 2;
          } else {
            drawW = ch * imgRatio;
            drawH = ch;
            drawX = (cw - drawW) / 2;
            drawY = 0;
          }

          ctx.clearRect(0, 0, cw, ch);
          ctx.drawImage(img, drawX, drawY, drawW, drawH);
        }

        function resizeCanvas() {
          if (!canvas) return;
          const rect = canvas.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = rect.width * dpr;
          canvas.height = rect.height * dpr;
          renderFrame(Math.round(frameSeq.frame));
        }

        // Load first frame immediately and render
        const firstImg = new Image();
        firstImg.src = getFrameUrl(0);
        firstImg.onload = () => {
          images[0] = firstImg;
          resizeCanvas();
        };
        images[0] = firstImg;

        // Preload remaining frames
        for (let i = 1; i < frameCount; i++) {
          const img = new Image();
          img.src = getFrameUrl(i);
          img.onload = () => {
            if (Math.round(frameSeq.frame) === i) {
              renderFrame(i);
            }
          };
          images[i] = img;
        }

        window.addEventListener("resize", resizeCanvas);
        resizeCanvas();

        // Hero ScrollTrigger scrub timeline
        const scrollTl = gsap.timeline({
          scrollTrigger: {
            trigger: ".hero-section",
            start: "top top",
            end: "+=2600",
            pin: true,
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });

        scrollTl.to(
          frameSeq,
          {
            frame: frameCount - 1,
            snap: "frame",
            ease: "none",
            onUpdate: () => {
              renderFrame(Math.round(frameSeq.frame));
            },
          },
          0
        );

        scrollTl.to(
          ".text-reveal-content",
          {
            y: "-110%",
            opacity: 0,
            filter: "blur(14px)",
            stagger: 0.04,
            ease: "power1.inOut",
          },
          0.12
        );

        scrollTl.to(
          ".hero-element",
          {
            y: -50,
            opacity: 0,
            filter: "blur(10px)",
            stagger: 0.04,
            ease: "power1.inOut",
          },
          0.12
        );
      }

      // 2. Tech Architecture Reveal (Dobra 2)
      const techHeader = gsap.utils.toArray(".tech-header-element");
      const techBenefits = gsap.utils.toArray(".tech-benefit-item");

      const techTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#tech-architecture",
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });

      techTl
        .fromTo(
          techHeader,
          { y: 40, opacity: 0, filter: "blur(8px)" },
          { y: 0, opacity: 1, filter: "blur(0px)", duration: 0.8, stagger: 0.1, ease: "power3.out" }
        )
        .fromTo(
          ".tech-card-visual",
          { scale: 0.94, opacity: 0, filter: "blur(10px)" },
          { scale: 1, opacity: 1, filter: "blur(0px)", duration: 0.9, ease: "power3.out" },
          "-=0.6"
        )
        .fromTo(
          techBenefits,
          { x: 30, opacity: 0, filter: "blur(6px)" },
          { x: 0, opacity: 1, filter: "blur(0px)", duration: 0.6, stagger: 0.08, ease: "power3.out" },
          "-=0.7"
        );

      // Progress bar sync
      gsap.to("#tech-progress-bar", {
        width: "100%",
        ease: "none",
        scrollTrigger: {
          trigger: "#tech-architecture",
          start: "top 50%",
          end: "bottom 85%",
          scrub: true,
        },
      });

      // 3. Precision Experience Reveal (Dobra 3)
      const expHeader = gsap.utils.toArray(".exp-header-element");
      const expStats = gsap.utils.toArray(".exp-stat-card");

      const expTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#precision-experience",
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });

      expTl
        .fromTo(
          expHeader,
          { y: 40, opacity: 0, filter: "blur(8px)" },
          { y: 0, opacity: 1, filter: "blur(0px)", duration: 0.8, stagger: 0.1, ease: "power3.out" }
        )
        .fromTo(
          expStats,
          { y: 30, opacity: 0, scale: 0.96 },
          { y: 0, opacity: 1, scale: 1, duration: 0.6, stagger: 0.08, ease: "power3.out" },
          "-=0.5"
        );

      // 4. Manifesto Reveal (Dobra 4)
      const manifestoTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#manifesto-glow-dobra4",
          start: "top 75%",
          toggleActions: "play none none reverse",
        },
      });

      manifestoTl.fromTo(
        ".glow-manifesto-card",
        { scale: 0.92, opacity: 0, filter: "blur(14px)" },
        { scale: 1, opacity: 1, filter: "blur(0px)", duration: 1.0, ease: "power3.out" }
      );

      // 5. Flashlight hover cards
      document.querySelectorAll(".flashlight-card").forEach((card) => {
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty("--mouse-x", `${x}px`);
          card.style.setProperty("--mouse-y", `${y}px`);
        });
      });

      // 6. 3D Tilt for Hero
      const videoContainer = document.querySelector(".video-container");
      if (videoContainer) {
        document.addEventListener("mousemove", (e) => {
          if (window.scrollY > window.innerHeight * 0.5) return;
          const xAxis = (window.innerWidth / 2 - e.pageX) / 60;
          const yAxis = (window.innerHeight / 2 - e.pageY) / 60;
          gsap.to(videoContainer, {
            rotationY: xAxis,
            rotationX: yAxis,
            ease: "power2.out",
            duration: 1,
          });
        });

        document.addEventListener("mouseleave", () => {
          gsap.to(videoContainer, {
            rotationY: 0,
            rotationX: 0,
            ease: "power2.out",
            duration: 1.5,
          });
        });
      }

      // Initial trigger refresh
      ScrollTrigger.refresh();
    }

    // Run setup when script executes and on DOM ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupAnimations);
    } else {
      setupAnimations();
    }
    window.addEventListener("load", () => {
      if (typeof ScrollTrigger !== "undefined") ScrollTrigger.refresh();
    });

    // Stroke Simulator Interaction
    const strokeSpecs = {
      "0.05": { strokeWidth: 1.2, spec: "ARTOOLS PIGMENTUM 0.05mm - ULTRA ULTRA-FINO", density: "99.9%", useCase: "Aplicação: Pontilhismo de precisão extrema, hachuras densas e desenho cirúrgico." },
      "0.1": { strokeWidth: 2.5, spec: "ARTOOLS PIGMENTUM 0.1mm - TRAÇO DE PRECISÃO", density: "99.8%", useCase: "Aplicação: Ilustração de Arquitetura, hachura milimétrica e escrita técnica." },
      "0.3": { strokeWidth: 4.5, spec: "ARTOOLS PIGMENTUM 0.3mm - TRAÇO INTERMEDIÁRIO", density: "99.5%", useCase: "Aplicação: Caligrafia fluida, esboços de conceitos e escrita diária encorpada." },
      "0.5": { strokeWidth: 6.5, spec: "ARTOOLS PIGMENTUM 0.5mm - LINHA EXECUTIVA", density: "99.2%", useCase: "Aplicação: Assinaturas de contratos, contornos marcantes e letras em negrito." },
      "0.8": { strokeWidth: 9.0, spec: "ARTOOLS PIGMENTUM 0.8mm - DENSIDADE MÁXIMA", density: "99.0%", useCase: "Aplicação: Preenchimento de áreas, títulos expressivos e arte gráfica pesada." },
    };

    function setStrokeSize(size, btn) {
      document.querySelectorAll(".stroke-btn").forEach((b) => {
        b.classList.remove("active", "bg-white", "text-stone-950", "font-bold");
        b.classList.add("text-stone-400");
      });
      btn.classList.add("active", "bg-white", "text-stone-950", "font-bold");
      btn.classList.remove("text-stone-400");

      const data = strokeSpecs[size];
      if (data) {
        const svgPath = document.getElementById("stroke-svg-path");
        const specBadge = document.getElementById("stroke-spec-badge");
        const densityTag = document.getElementById("stroke-density-tag");
        const useCase = document.getElementById("stroke-use-case");

        if (svgPath) svgPath.setAttribute("stroke-width", data.strokeWidth);
        if (specBadge) specBadge.textContent = data.spec;
        if (densityTag) densityTag.textContent = `Densidade Nanométrica: ${data.density}`;
        if (useCase) useCase.textContent = data.useCase;
      }
    }

    document.querySelectorAll(".stroke-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const size = btn.getAttribute("data-size");
        if (size) setStrokeSize(size, btn);
      });
    });

    // Stress Test Interaction
    const stressData = {
      water: { title: "Teste de Água:", desc: "Pigmentos de carbono fixam-se instantaneamente às fibras do papel. Sem manchas ou desbotamento mesmo sob chuva ou imersão direta." },
      uv: { title: "Teste Solar & UV:", desc: "Resistência fotolítica absoluta. O traço mantém a saturação de preto absoluto inalterada por mais de 100 anos em exposição contínua." },
      chemical: { title: "Teste com Solventes:", desc: "Fórmula à prova de álcool isopropílico, acetona e produtos de limpeza. Ideal para assinaturas de segurança e documentos históricos." },
    };

    function toggleStressTest(testKey, btn) {
      document.querySelectorAll(".stress-btn").forEach((b) => {
        b.classList.remove("active", "bg-stone-800/80", "border-stone-700");
        b.classList.add("bg-stone-950/60", "border-stone-800");
        const titleSpan = b.querySelector(".font-bold");
        if (titleSpan) titleSpan.classList.replace("text-white", "text-stone-300");
      });

      btn.classList.add("active", "bg-stone-800/80", "border-stone-700");
      btn.classList.remove("bg-stone-950/60", "border-stone-800");
      const activeTitle = btn.querySelector(".font-bold");
      if (activeTitle) activeTitle.classList.replace("text-stone-300", "text-white");

      const info = stressData[testKey];
      const descBox = document.getElementById("stress-desc-box");
      if (info && descBox) {
        descBox.innerHTML = `<span class="text-white font-bold block mb-0.5">${info.title}</span>${info.desc}`;
      }
    }

    document.querySelectorAll(".stress-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const stress = btn.getAttribute("data-stress");
        if (stress) toggleStressTest(stress, btn);
      });
    });

    // Button Scroll actions
    const heroBuyBtn = document.getElementById("hero-buy-btn");
    if (heroBuyBtn) {
      heroBuyBtn.addEventListener("click", () => {
        window.lenis?.scrollTo("#manifesto-glow-dobra4");
      });
    }

    const heroExploreBtn = document.getElementById("hero-explore-btn");
    if (heroExploreBtn) {
      heroExploreBtn.addEventListener("click", () => {
        window.lenis?.scrollTo("#tech-architecture");
      });
    }

    const sec3CtaBtn = document.getElementById("sec3-cta-btn");
    if (sec3CtaBtn) {
      sec3CtaBtn.addEventListener("click", () => {
        window.lenis?.scrollTo("#manifesto-glow-dobra4");
      });
    }

    const manifestoAccessBtn = document.getElementById("manifesto-access-btn");
    if (manifestoAccessBtn) {
      manifestoAccessBtn.addEventListener("click", () => {
        window.lenis?.scrollTo("#hero-title");
      });
    }
  </script>
